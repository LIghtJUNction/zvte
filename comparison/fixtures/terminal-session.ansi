[32m+[m[32m                    self.utf8[..len].copy_from_slice(&input[..len]);[m
[32m+[m[32m                    self.utf8_len = len as u8;[m
[32m+[m[32m                    len[m
[32m+[m[32m                }[m
[32m+[m[32m            },[m
