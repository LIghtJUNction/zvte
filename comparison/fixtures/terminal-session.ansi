[32m+[m[32m//! Zero-dependency, allocation-free ANSI/VT terminal parsing.[m
[32m+[m[32m//![m
[32m+[m[32m//! Feed arbitrary byte chunks to [`Parser::advance`]. Implement [`Perform`] to[m
[32m+[m[32m//! consume decoded text and control sequences; override [`Perform::text`] to[m
[32m+[m[32m//! receive contiguous printable ASCII in batches. The default implementation[m
[32m+[m[32m//! preserves one [`Perform::print`] callback per character.[m
[32m+[m[32m//![m
[32m+[m[32m//! ```[m
[32m+[m[32m//! use zvte::{Parser, Perform, Params};[m
[32m+[m[32m//![m
[32m+[m[32m//! struct Screen;[m
[32m+[m[32m//! impl Perform for Screen {[m
[32m+[m[32m//!     fn print(&mut self, c: char) { /* draw c */ let _ = c; }[m
[32m+[m[32m//!     fn csi_dispatch(&mut self, p: &Params, i: &[u8], ignore: bool, action: char) {[m
[32m+[m[32m//!         if !ignore && i.is_empty() && action == 'm' {[m
[32m+[m[32m//!             for parameter in p { let _ = parameter; /* apply SGR */ }[m
[32m+[m[32m//!         }[m
[32m+[m[32m//!     }[m
[32m+[m[32m//! }[m
[32m+[m[32m//! let mut parser = Parser::new();[m
[32m+[m[32m//! parser.advance(b"\x1b[31mred\x1b[0m", &mut Screen);[m
[32m+[m[32m//! ```[m
[32m+[m[32m//![m
[32m+[m[32m//! Control sequence semantics follow `vte 0.15.0` in its bounded, no-std mode:[m
[32m+[m[32m//! 32 numeric entries, two intermediate bytes, 16 OSC fields, UTF-8 text and[m
[32m+[m[32m//! seven-bit sequence introducers. Raw C1 bytes in text are executed. See the[m
[32m+[m[32m//! README for EOF behavior, capacity limits and the split UTF-8 C1 correction.[m
[32m+[m[32m#![no_std][m
[32m+[m[32m#![forbid(unsafe_code)][m
[32m+[m[32m#![deny(missing_docs)][m
[32m+[m
[32m+[m[32mmod params;[m
[32m+[m[32mmod scan;[m
[32m+[m[32mmod state;[m
[32m+[m
[32m+[m[32mpub use params::{Params, ParamsIter, MAX_PARAMS};[m
[32m+[m[32muse state::*;[m
[32m+[m
[32m+[m[32m/// Default number of stored OSC payload bytes (separators consume no space).[m
[32m+[m[32mpub const DEFAULT_OSC_CAPACITY: usize = 1024;[m
[32m+[m[32m/// Maximum number of semicolon-separated OSC fields passed to the handler.[m
[32m+[m[32mpub const MAX_OSC_PARAMS: usize = 16;[m
[32m+[m[32m/// Maximum number of stored private-marker and intermediate bytes.[m
[32m+[m[32mpub const MAX_INTERMEDIATES: usize = 2;[m
[32m+[m
[32m+[m[32m/// Incremental ANSI/VT parser with all state and storage held inline.[m
[32m+[m[32m///[m
[32m+[m[32m/// `N` is the OSC payload capacity. Use [`Parser::new_with_size`] to customize[m
[32m+[m[32m/// it, including zero on memory-constrained targets. Overflowing numeric[m
[32m+[m[32m/// parameters/intermediates set the dispatch `ignore` flag; overflowing OSC[m
[32m+[m[32m/// data is truncated, with [`Perform::osc_overflow`] called once per command.[m
[32m+[m[32m///[m
[32m+[m[32m/// A parser can be moved between threads; one byte stream requires one parser.[m
[32m+[m[32m/// Handler panics propagate normally. Parser operations themselves do not panic[m
[32m+[m[32m/// for any byte input. No allocation, global mutable state or unsafe code is used.[m
[32m+[m[32m#[derive(Clone)][m
[32m+[m[32mpub struct Parser<const N: usize = DEFAULT_OSC_CAPACITY> {[m
[32m+[m[32m    osc: [u8; N],[m
[32m+[m[32m    osc_ends: [usize; MAX_OSC_PARAMS],[m
[32m+[m[32m    osc_len: usize,[m
[32m+[m[32m    params: Params,[m
[32m+[m[32m    param: u16,[m
[32m+[m[32m    utf8: [u8; 4],[m
[32m+[m[32m    intermediates: [u8; MAX_INTERMEDIATES],[m
[32m+[m[32m    state: u8,[m
[32m+[m[32m    intermediate_len: u8,[m
[32m+[m[32m    osc_count: u8,[m
[32m+[m[32m    utf8_len: u8,[m
[32m+[m[32m    ignoring: bool,[m
[32m+[m[32m    osc_overflow: bool,[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mimpl Parser {[m
[32m+[m[32m    /// Create a parser with a 1024-byte inline OSC buffer.[m
[32m+[m[32m    pub const fn new() -> Self {[m
[32m+[m[32m        Self::new_with_size()[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mimpl<const N: usize> Default for Parser<N> {[m
[32m+[m[32m    fn default() -> Self {[m
[32m+[m[32m        Self::new_with_size()[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mimpl<const N: usize> Parser<N> {[m
[32m+[m[32m    /// Create a parser with an explicit inline OSC payload capacity.[m
[32m+[m[32m    pub const fn new_with_size() -> Self {[m
[32m+[m[32m        Self {[m
[32m+[m[32m            osc: [0; N],[m
[32m+[m[32m            osc_ends: [0; MAX_OSC_PARAMS],[m
[32m+[m[32m            osc_len: 0,[m
[32m+[m[32m            params: Params::new(),[m
[32m+[m[32m            param: 0,[m
[32m+[m[32m            utf8: [0; 4],[m
[32m+[m[32m            intermediates: [0; MAX_INTERMEDIATES],[m
[32m+[m[32m            state: GROUND,[m
[32m+[m[32m            intermediate_len: 0,[m
[32m+[m[32m            osc_count: 0,[m
[32m+[m[32m            utf8_len: 0,[m
[32m+[m[32m            ignoring: false,[m
[32m+[m[32m            osc_overflow: false,[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Whether no control sequence or partial UTF-8 codepoint is pending.[m
[32m+[m[32m    #[inline][m
[32m+[m[32m    pub const fn is_ground(&self) -> bool {[m
[32m+[m[32m        self.state == GROUND && self.utf8_len == 0[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Discard all pending input without issuing callbacks or clearing storage.[m
[32m+[m[32m    pub fn reset(&mut self) {[m
[32m+[m[32m        self.state = GROUND;[m
[32m+[m[32m        self.utf8_len = 0;[m
[32m+[m[32m        self.osc_len = 0;[m
[32m+[m[32m        self.osc_count = 0;[m
[32m+[m[32m        self.osc_overflow = false;[m
