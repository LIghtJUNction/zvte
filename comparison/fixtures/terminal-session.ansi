[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Parse a chunk, preserving incomplete sequences for the next call.[m
[32m+[m[32m    ///[m
[32m+[m[32m    /// Empty input is a no-op. Callbacks borrow parser/input storage only for[m
[32m+[m[32m    /// the duration of the call. Batch boundaries depend on the input chunks;[m
[32m+[m[32m    /// the expanded character/control event stream does not.[m
[32m+[m[32m    #[inline][m
[32m+[m[32m    pub fn advance<P: Perform + ?Sized>(&mut self, input: &[u8], handler: &mut P) {[m
[32m+[m[32m        let mut i = 0;[m
