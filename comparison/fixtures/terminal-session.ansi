[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Finish a stream: replace incomplete UTF-8, unhook an active DCS, then reset.[m
[32m+[m[32m    ///[m
[32m+[m[32m    /// Incomplete ESC/CSI/OSC commands are discarded. Ordinary chunk boundaries[m
[32m+[m[32m    /// must use [`Self::advance`] without calling this method. Repeated calls[m
[32m+[m[32m    /// without intervening input have no effect.[m
[32m+[m[32m    pub fn finish<P: Perform + ?Sized>(&mut self, handler: &mut P) {[m
[32m+[m[32m        if self.utf8_len != 0 {[m
[32m+[m[32m            handler.print('\u{fffd}');[m
[32m+[m[32m        }[m
[32m+[m[32m        if self.state == DCS_DATA {[m
[32m+[m[32m            handler.unhook();[m
[32m+[m[32m        }[m
