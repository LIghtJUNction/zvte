[32m+[m[32m            if self.state == GROUND {[m
[32m+[m[32m                if self.utf8_len != 0 {[m
[32m+[m[32m                    i += self.complete_utf8(&input[i..], handler);[m
[32m+[m[32m                    continue;[m
[32m+[m[32m                }[m
[32m+[m[32m                let run = scan::ascii_run(&input[i..]);[m
[32m+[m[32m                if run != 0 {[m
[32m+[m[32m                    // Validation is safe and optimized to word operations by core.[m
