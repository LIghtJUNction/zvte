[32m+[m[32m                    handler.execute(byte);[m
[32m+[m[32m                    i += 1;[m
[32m+[m[32m                } else {[m
[32m+[m[32m                    i += self.start_utf8(&input[i..], handler);[m
[32m+[m[32m                }[m
[32m+[m[32m            } else {[m
[32m+[m[32m                let byte = input[i];[m
