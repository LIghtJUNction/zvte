[32m+[m[32m        match core::str::from_utf8(&self.utf8[..old + take]) {[m
[32m+[m[32m            Ok(text) => {[m
[32m+[m[32m                if let Some(c) = text.chars().next() {[m
[32m+[m[32m                    Self::decoded(handler, c);[m
[32m+[m[32m                }[m
[32m+[m[32m                self.utf8_len = 0;[m
[32m+[m[32m                take[m
[32m+[m[32m            }[m
[32m+[m[32m            Err(error) => match error.error_len() {[m
[32m+[m[32m                Some(invalid) => {[m
[32m+[m[32m                    self.utf8_len = 0;[m
[32m+[m[32m                    handler.print('\u{fffd}');[m
[32m+[m[32m                    invalid.saturating_sub(old)[m
[32m+[m[32m                }[m
[32m+[m[32m                None => {[m
[32m+[m[32m                    self.utf8_len = (old + take) as u8;[m
[32m+[m[32m                    take[m
[32m+[m[32m                }[m
[32m+[m[32m            },[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/// Consumer of terminal parsing events. Unimplemented methods discard events.[m
[32m+[m[32m///[m
[32m+[m[32m/// With the exception of `text` and `osc_overflow`, callback names and arguments[m
[32m+[m[32m/// mirror `vte::Perform`. No allocation is required to implement this trait.[m
[32m+[m[32mpub trait Perform {[m
[32m+[m[32m    /// One decoded printable Unicode scalar, including DEL.[m
[32m+[m[32m    fn print(&mut self, _c: char) {}[m
[32m+[m[32m    /// A run of printable ASCII. Defaults to one [`Self::print`] per character.[m
[32m+[m[32m    ///[m
[32m+[m[32m    /// Overriding this method reduces callback overhead; preserve order relative[m
[32m+[m[32m    /// to all other callbacks. Call boundaries are not part of text semantics.[m
[32m+[m[32m    #[inline][m
[32m+[m[32m    fn text(&mut self, text: &str) {[m
[32m+[m[32m        for byte in text.bytes() {[m
[32m+[m[32m            self.print(byte as char);[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m    /// Execute a C0 or C1 control byte.[m
[32m+[m[32m    fn execute(&mut self, _byte: u8) {}[m
[32m+[m[32m    /// Complete ESC command. `ignore` signals intermediate overflow.[m
[32m+[m[32m    fn esc_dispatch(&mut self, _intermediates: &[u8], _ignore: bool, _byte: u8) {}[m
[32m+[m[32m    /// Complete CSI command. `ignore` signals parameter/intermediate overflow.[m
[32m+[m[32m    fn csi_dispatch([m
[32m+[m[32m        &mut self,[m
[32m+[m[32m        _params: &Params,[m
[32m+[m[32m        _intermediates: &[u8],[m
[32m+[m[32m        _ignore: bool,[m
[32m+[m[32m        _action: char,[m
[32m+[m[32m    ) {[m
[32m+[m[32m    }[m
[32m+[m[32m    /// Start DCS data after its final header byte, with parsed parameters.[m
[32m+[m[32m    fn hook(&mut self, _params: &Params, _intermediates: &[u8], _ignore: bool, _action: char) {}[m
[32m+[m[32m    /// One DCS data byte; DEL and high bytes other than ST are ignored.[m
[32m+[m[32m    fn put(&mut self, _byte: u8) {}[m
[32m+[m[32m    /// End or cancel the active DCS data stream.[m
[32m+[m[32m    fn unhook(&mut self) {}[m
[32m+[m[32m    /// Complete OSC command. `bell_terminated` is true only for BEL termination.[m
[32m+[m[32m    ///[m
[32m+[m[32m    /// ESC ends the OSC immediately; a following `\\` is a separate ESC event.[m
[32m+[m[32m    /// CAN/SUB also dispatch OSC before their execute callback, matching vte.[m
[32m+[m[32m    fn osc_dispatch(&mut self, _params: &[&[u8]], _bell_terminated: bool) {}[m
[32m+[m[32m    /// OSC storage or field capacity was exceeded, once per OSC command.[m
[32m+[m[32m    ///[m
[32m+[m[32m    /// The eventual dispatch contains the bounded prefix. This extra callback[m
[32m+[m[32m    /// makes truncation observable without changing vte-compatible dispatches.[m
[32m+[m[32m    fn osc_overflow(&mut self) {}[m
[32m+[m[32m}[m
