[32m+[m[32m            ESC_DISPATCH => handler.esc_dispatch([m
[32m+[m[32m                &self.intermediates[..self.intermediate_len as usize],[m
[32m+[m[32m                self.ignoring,[m
[32m+[m[32m                byte,[m
