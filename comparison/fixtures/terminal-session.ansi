[32m+[m[32m                i += 1;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    #[inline][m
[32m+[m[32m    fn clear_params(&mut self) {[m
[32m+[m[32m        self.params.clear();[m
[32m+[m[32m        self.param = 0;[m
[32m+[m[32m        self.intermediate_len = 0;[m
[32m+[m[32m        self.ignoring = false;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    #[inline][m
[32m+[m[32m    fn step<P: Perform + ?Sized>(&mut self, byte: u8, handler: &mut P) {[m
[32m+[m[32m        let transition = TRANSITIONS[self.state as usize][byte as usize];[m
[32m+[m[32m        self.state = (transition & 15) as u8;[m
[32m+[m[32m        match (transition >> 4) as u8 {[m
[32m+[m[32m            IGNORE => {}[m
[32m+[m[32m            EXECUTE => handler.execute(byte),[m
[32m+[m[32m            COLLECT => {[m
[32m+[m[32m                if (self.intermediate_len as usize) < MAX_INTERMEDIATES {[m
